# Anthropic API key for Heckr. Server-side only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown). All routes use Claude Haiku 5.5 at medium effort.
# HECKR_MODEL=claude-haiku-5-5
# HECKR_RATE_LIMIT=20            # quick-chat messages per IP per window
# HECKR_RATE_WINDOW_MINUTES=10
# HECKR_MENTOR_LIMIT=40          # Build mode mentor messages per IP per 10 min
# HECKR_PLAN_LIMIT=6             # Build mode plans per IP per 30 min
